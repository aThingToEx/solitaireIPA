# Stable iOS capture behavior. Devices, games, and paths are supplied by the
# `screenshots` lane because they depend on its runtime options.

scheme("ComputerSolitaireScreenshots")
languages(["en-US"])

override_status_bar(true)
concurrent_simulators(false)
headless(true)
dark_mode(true)
skip_open_summary(true)
clear_previous_screenshots(false)
number_of_retries(0)
stop_after_first_error(true)
test_without_building(true)
